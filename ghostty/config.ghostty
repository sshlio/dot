window-decoration       = none
macos-titlebar-style    = hidden
confirm-close-surface   = false
mouse-hide-while-typing = true

cursor-invert-fg-bg = true
cursor-style-blink = false

macos-shortcuts             = deny
macos-non-native-fullscreen = true
macos-icon                  = xray
window-vsync                = false
key-remap                   = super=ctrl

keybind = super+shift+w=close_window
keybind = super+w=unbind
keybind = super+a=unbind
keybind = super+t=unbind
keybind = super+d=unbind
keybind = super+n=unbind

font-size = 18
font-family = Monaspace Neon
font-variation = wght=800
font-thicken = true
font-thicken-strength = 50

font-feature = +calt
font-feature = +liga
font-feature = +ss01
font-feature = +ss02
font-feature = +ss03
font-feature = +ss04
font-feature = +ss05
font-feature = +ss06
font-feature = +ss07
font-feature = +ss08
font-feature = +ss09

